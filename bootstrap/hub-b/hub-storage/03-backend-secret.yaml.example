# Copy to 03-backend-secret.yaml (git-ignored), fill in, apply. NetApp's be-otsc3-secret.yaml.
# The account needs the http and ontapi applications on the hub's SVM. Used by both backends (03g and 03h).
apiVersion: v1
kind: Secret
metadata:
  name: be-ontap-nas-hub-b-secret
  namespace: trident
type: Opaque
stringData:
  username: trident_admin            # SVM_TEST account for Trident (http and ontapi); confirmed with a 200 from the ONTAP API
  password: CHANGEME
