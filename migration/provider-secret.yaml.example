# vCenter credentials for MTV. Copy to provider-secret.yaml (git-ignored) and fill in.
apiVersion: v1
kind: Secret
metadata:
  name: vcenter-credentials
  namespace: openshift-mtv
  labels:
    createdForProviderType: vsphere
    createdForResourceType: providers
type: Opaque
stringData:
  user: CHANGEME@vsphere.local
  password: CHANGEME
  insecureSkipVerify: "false"
  cacert: |
    -----BEGIN CERTIFICATE-----
    CHANGEME: PEM certificate
    -----END CERTIFICATE-----
