# The single home for install-time secrets. Applied to the HUB once, by hand or from your vault
# (External Secrets Operator). Never committed with real values.
#   cp install-secrets.yaml.example install-secrets.yaml && vi install-secrets.yaml && oc apply -f install-secrets.yaml
# The "install-secrets" policy copies these into every cluster namespace, and re-copies them
# whenever a cluster namespace is recreated, so a redeploy needs no manual secret step.
# The namespace itself is created from git (hub/acm/install-secrets-namespace.yaml).
apiVersion: v1
kind: Secret
metadata:
  name: pull-secret
  namespace: cluster-install-secrets
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: 'CHANGEME'   # the whole pull secret from console.redhat.com/openshift/install/pull-secret
---
# Default BMC login, used for every host in every cluster.
apiVersion: v1
kind: Secret
metadata:
  name: bmc-credentials
  namespace: cluster-install-secrets
type: Opaque
stringData:
  username: CHANGEME
  password: CHANGEME
---
# Optional per-cluster override: name it bmc-credentials-<cluster> and it wins over the default.
# apiVersion: v1
# kind: Secret
# metadata:
#   name: bmc-credentials-ocp-b
#   namespace: cluster-install-secrets
# type: Opaque
# stringData:
#   username: CHANGEME
#   password: CHANGEME
