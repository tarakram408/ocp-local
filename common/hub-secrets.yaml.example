# Secrets the common/ policies copy to the clusters. They are created by hand on EACH hub
# (hub-a and hub-b), in the "policies" namespace, and never committed. Copy this file to
# common/hub-secrets.yaml (git-ignored), fill it in, then:
#   oc apply -f common/hub-secrets.yaml        # once on hub-a, once on hub-b
# Only the ones for the features switched on are needed.
#
# 1 htpasswd: the local break-glass admin (user name = htpasswdAdminUser in common/values.yaml)
#   htpasswd -c -B -b users.htpasswd ocpadmin '<password>'
#   oc -n policies create secret generic htpasswd --from-file=htpasswd=users.htpasswd
apiVersion: v1
kind: Secret
metadata:
  name: htpasswd
  namespace: policies
type: Opaque
stringData:
  htpasswd: |
    ocpadmin:$2y$05$CHANGEME
---
# 2 Active Directory: the bind account's password (CN=svc-ldap unless a dedicated account is created), and,
# only when ldapInsecure is "false" (LDAPS), the CA that signed the domain controllers' certificate
apiVersion: v1
kind: Secret
metadata:
  name: ldap-bind
  namespace: policies
type: Opaque
stringData:
  bindPassword: CHANGEME
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ldap-ca
  namespace: policies
data:
  ca.crt: |
    -----BEGIN CERTIFICATE-----
    CHANGEME: PEM certificate
    -----END CERTIFICATE-----
---
# 8 Ingress certificate, one per cluster, named <ManagedCluster name>-ingress-cert.
# On a hub, the hub's own one is "local-cluster-ingress-cert". tls.crt is the full chain (server first).
#   oc -n policies create secret tls ocp-a-ingress-cert --cert=ocp-a-apps-chain.pem --key=ocp-a-apps.key
#   oc -n policies create secret tls ocp-b-ingress-cert --cert=ocp-b-apps-chain.pem --key=ocp-b-apps.key
#   oc -n policies create secret tls local-cluster-ingress-cert --cert=<hub>-apps-chain.pem --key=<hub>-apps.key
---
# 11 Alerting: only when the SMTP relay needs a login (alertSmtpAuthUser set in common/values.yaml)
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-smtp
  namespace: policies
type: Opaque
stringData:
  password: CHANGEME
